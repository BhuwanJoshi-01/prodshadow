{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BhuwanJoshi-01/Open-Source-1/schemas/workload.v1.schema.json",
  "title": "ProdShadow workload definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenarios"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string"},
    "think_time_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
    "background": {"type": "array", "items": {"$ref": "#/$defs/background"}},
    "compatibility": {"type": "array", "items": {"$ref": "#/$defs/app_version"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statements"],
      "properties": {
        "statements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hold_ms": {"type": "integer", "minimum": 0, "maximum": 600000}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "mode"],
      "oneOf": [{"required": ["sql"]}, {"required": ["transaction"]}],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "mode": {"enum": ["read", "write"]},
        "sql": {"type": "string"},
        "transaction": {"$ref": "#/$defs/transaction"},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/generator"}},
        "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}
      }
    },
    "app_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "probes"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sql"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sql": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/generator"}}
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessions", "transaction"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sessions": {"type": "integer", "minimum": 1, "maximum": 64},
        "start_after_seconds": {"type": "number", "minimum": 0},
        "repeat": {"type": "boolean"},
        "transaction": {"$ref": "#/$defs/transaction"},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/generator"}}
      }
    },
    "generator": {
      "type": "object",
      "required": ["generator"],
      "properties": {
        "generator": {"enum": ["int_range", "float_range", "zipf", "choice", "const", "sequence", "text", "uuid", "timestamp_range", "pattern", "bool"]},
        "min": {"type": "number"}, "max": {"type": "number"}, "s": {"type": "number", "exclusiveMinimum": 1},
        "values": {"type": "array", "minItems": 1}, "weights": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "value": {}, "start": {"type": "integer"}, "step": {"type": "integer"},
        "min_length": {"type": "integer", "minimum": 0}, "max_length": {"type": "integer", "minimum": 0},
        "from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"},
        "format": {"type": "string"}, "true_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "null_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
